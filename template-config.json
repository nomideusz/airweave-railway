{
  "services": {
    "1fff2187-7b6e-4fb5-9312-3daf6252758c": {
      "icon": "https://raw.githubusercontent.com/nomideusz/airweave-railway/main/icon.svg",
      "name": "Airweave",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/healthz",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/nomideusz/airweave-railway",
        "rootDirectory": "/gateway"
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>": {}
        }
      },
      "volumeMounts": {},
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "Port the gateway listens on - leave as is",
          "isOptional": false
        },
        "AIRWEAVE_USERNAME": {
          "defaultValue": "admin",
          "description": "Username for signing in to the Airweave web app",
          "isOptional": false
        },
        "AIRWEAVE_PASSWORD": {
          "defaultValue": "${{secret(24, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated password for the Airweave web app (HTTP basic auth)",
          "isOptional": false
        },
        "AIRWEAVE_API_KEY": {
          "defaultValue": "aw_${{secret(40, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated API key: send it as the X-API-Key header (SDKs, MCP, curl) to reach /api without the password",
          "isOptional": false
        },
        "BACKEND_UPSTREAM": {
          "defaultValue": "${{Backend.RAILWAY_PRIVATE_DOMAIN}}:8001",
          "description": "Airweave API on the private network",
          "isOptional": false
        }
      }
    },
    "e85326c2-d2ee-4327-988f-e29f488a81c8": {
      "icon": "https://raw.githubusercontent.com/nomideusz/airweave-railway/main/icon.svg",
      "name": "Backend",
      "build": {},
      "deploy": {
        "startCommand": "uvicorn airweave.main:app --host 0.0.0.0 --port 8001",
        "healthcheckPath": "/health/ready",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "ghcr.io/airweave-ai/airweave-backend:v0.9.73"
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {},
      "variables": {
        "PORT": {
          "defaultValue": "8001",
          "description": "Port the API listens on - leave as is",
          "isOptional": false
        },
        "ENVIRONMENT": {
          "defaultValue": "self-hosted",
          "description": "Airweave's self-hosted mode: bring-your-own OAuth apps for OAuth sources, local file storage",
          "isOptional": false
        },
        "AUTH_ENABLED": {
          "defaultValue": "false",
          "description": "Airweave's own login needs an Auth0 tenant; off here, the Airweave gateway's password and API key protect the API instead",
          "isOptional": false
        },
        "ANALYTICS_ENABLED": {
          "defaultValue": "false",
          "description": "Send anonymous usage analytics to Airweave's PostHog - off by default",
          "isOptional": false
        },
        "FIRST_SUPERUSER": {
          "defaultValue": "admin@example.org",
          "description": "Email of the built-in admin account all requests act as (shown in the app; any valid address)",
          "isOptional": false
        },
        "FIRST_SUPERUSER_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated password of the built-in admin record (required by Airweave, not used to sign in)",
          "isOptional": false
        },
        "ENCRYPTION_KEY": {
          "defaultValue": "${{secret(43, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_\")}}=",
          "description": "Fernet key that encrypts stored source credentials. BACK IT UP - changing it makes every connected source unreadable",
          "isOptional": false
        },
        "STATE_SECRET": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Signs OAuth state tokens when connecting sources",
          "isOptional": false
        },
        "MISTRAL_API_KEY": {
          "defaultValue": "",
          "description": "Mistral API key (required): embeddings (mistral-embed), OCR of PDFs and images, and the classic/agentic search LLM. Get one at console.mistral.ai",
          "isOptional": false
        },
        "DENSE_EMBEDDER": {
          "defaultValue": "mistral_embed",
          "description": "Embedding model: mistral_embed (1024 dims), openai_text_embedding_3_small (1536) or openai_text_embedding_3_large (3072). Fixed after the first sync",
          "isOptional": false
        },
        "EMBEDDING_DIMENSIONS": {
          "defaultValue": "${{Vespa.EMBEDDING_DIMENSIONS}}",
          "description": "Embedding size, set on the Vespa service so the search schema matches",
          "isOptional": false
        },
        "SPARSE_EMBEDDER": {
          "defaultValue": "fastembed_bm25",
          "description": "Keyword (BM25) embedder, runs locally",
          "isOptional": false
        },
        "LLM_FALLBACK_CHAIN": {
          "defaultValue": "mistral:mistral-large,anthropic:claude-sonnet-4.6,together:zai-glm-5",
          "description": "Search LLM chain (classic/agentic tiers); entries without an API key are skipped",
          "isOptional": false
        },
        "OPENAI_API_KEY": {
          "defaultValue": "",
          "description": "Optional: OpenAI key, only if you switch DENSE_EMBEDDER to an OpenAI model before the first deploy",
          "isOptional": true
        },
        "ANTHROPIC_API_KEY": {
          "defaultValue": "",
          "description": "Optional: Anthropic key, fallback LLM for classic and agentic search",
          "isOptional": true
        },
        "TOGETHER_API_KEY": {
          "defaultValue": "",
          "description": "Optional: Together AI key, fallback LLM for classic and agentic search",
          "isOptional": true
        },
        "POSTGRES_HOST": {
          "defaultValue": "${{Postgres.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Postgres on the private network",
          "isOptional": false
        },
        "POSTGRES_PORT": {
          "defaultValue": "5432",
          "description": "Postgres port",
          "isOptional": false
        },
        "POSTGRES_DB": {
          "defaultValue": "${{Postgres.POSTGRES_DB}}",
          "description": "Database name",
          "isOptional": false
        },
        "POSTGRES_USER": {
          "defaultValue": "${{Postgres.POSTGRES_USER}}",
          "description": "Database user",
          "isOptional": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{Postgres.POSTGRES_PASSWORD}}",
          "description": "Database password",
          "isOptional": false
        },
        "REDIS_HOST": {
          "defaultValue": "${{Redis.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Redis on the private network",
          "isOptional": false
        },
        "REDIS_PORT": {
          "defaultValue": "6379",
          "description": "Redis port",
          "isOptional": false
        },
        "REDIS_PASSWORD": {
          "defaultValue": "${{Redis.REDIS_PASSWORD}}",
          "description": "Redis password",
          "isOptional": false
        },
        "TEMPORAL_HOST": {
          "defaultValue": "${{Temporal.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Temporal (sync orchestration) on the private network",
          "isOptional": false
        },
        "TEMPORAL_PORT": {
          "defaultValue": "7233",
          "description": "Temporal gRPC port",
          "isOptional": false
        },
        "VESPA_URL": {
          "defaultValue": "http://${{Vespa.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Vespa search index on the private network",
          "isOptional": false
        },
        "VESPA_PORT": {
          "defaultValue": "8081",
          "description": "Vespa query and document API port",
          "isOptional": false
        },
        "SVIX_URL": {
          "defaultValue": "http://${{Svix.RAILWAY_PRIVATE_DOMAIN}}:8071",
          "description": "Svix webhook server on the private network",
          "isOptional": false
        },
        "SVIX_JWT_SECRET": {
          "defaultValue": "${{Svix.SVIX_JWT_SECRET}}",
          "description": "Shared secret for the Svix API",
          "isOptional": false
        },
        "API_FULL_URL": {
          "defaultValue": "https://${{Airweave.RAILWAY_PUBLIC_DOMAIN}}/api",
          "description": "Public API URL (OAuth callbacks, links) - change the domain if you add a custom one",
          "isOptional": false
        },
        "APP_FULL_URL": {
          "defaultValue": "https://${{Airweave.RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public app URL - change the domain if you add a custom one",
          "isOptional": false
        },
        "STORAGE_BACKEND": {
          "defaultValue": "filesystem",
          "description": "Raw sync data is written by the Worker to its volume",
          "isOptional": false
        },
        "STORAGE_PATH": {
          "defaultValue": "/data/airweave-storage",
          "description": "Where raw sync data lives (the Worker's volume)",
          "isOptional": false
        },
        "RAILWAY_HEALTHCHECK_TIMEOUT_SEC": {
          "defaultValue": "600",
          "description": "The first boot runs 150+ database migrations before the health check can pass",
          "isOptional": false
        }
      }
    },
