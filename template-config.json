    "2eee9dd0-73a9-4c5e-b3a8-9f56c7394963": {
      "icon": "https://raw.githubusercontent.com/nomideusz/airweave-railway/main/icons/svix.svg",
      "name": "Svix",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "svix/svix-server:v1.101.0"
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {},
      "variables": {
        "SVIX_JWT_SECRET": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated secret for the Svix API (shared with the Backend)",
          "isOptional": false
        },
        "SVIX_DB_DSN": {
          "defaultValue": "postgresql://${{Postgres.POSTGRES_USER}}:${{Postgres.POSTGRES_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/svix",
          "description": "Svix database (created by Postgres on first boot)",
          "isOptional": false
        },
        "SVIX_REDIS_DSN": {
          "defaultValue": "redis://default:${{Redis.REDIS_PASSWORD}}@${{Redis.RAILWAY_PRIVATE_DOMAIN}}:6379",
          "description": "Redis for Svix's delivery queue",
          "isOptional": false
        },
        "SVIX_QUEUE_TYPE": {
          "defaultValue": "redis",
          "description": "Delivery queue backend",
          "isOptional": false
        },
        "SVIX_CACHE_TYPE": {
          "defaultValue": "none",
          "description": "Upstream's setting: the memory cache delivers to stale endpoint lists",
          "isOptional": false
        },
        "WAIT_FOR": {
          "defaultValue": "true",
          "description": "Wait for Postgres and Redis before starting",
          "isOptional": false
        }
      }
    },
    "ff3b34d8-d9a1-4bc3-bc1f-627abc1c6a74": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "name": "Postgres",
      "build": {},
      "deploy": {
        "startCommand": "/bin/sh -c \"echo 'CREATE DATABASE svix;' > /docker-entrypoint-initdb.d/10-svix.sql && exec docker-entrypoint.sh postgres -c max_connections=200\"",
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "postgres:16.15"
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "b1453ca3-e088-4dba-919a-84442b737220": {
          "mountPath": "/var/lib/postgresql/data"
        }
      },
      "variables": {
        "POSTGRES_DB": {
          "defaultValue": "airweave",
          "description": "Database name",
          "isOptional": false
        },
        "POSTGRES_USER": {
          "defaultValue": "airweave",
          "description": "Database user",
          "isOptional": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated database password",
          "isOptional": false
        },
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Data subdirectory - keeps Postgres happy on Railway volumes",
          "isOptional": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Time for Postgres to shut down cleanly on redeploy",
          "isOptional": false
        }
