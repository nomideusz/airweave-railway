    "36ad0100-1c6b-4320-8db3-2f7414ab7e93": {
      "icon": "https://raw.githubusercontent.com/nomideusz/airweave-railway/main/icons/temporal.svg",
      "name": "Temporal",
      "build": {},
      "deploy": {
        "startCommand": "/bin/bash -c \"(until temporal operator search-attribute list --namespace default 2>/dev/null | grep -qw SyncId; do sleep 5; temporal operator search-attribute create --namespace default --name SyncId --type Keyword >/dev/null 2>&1; done; echo SyncId search attribute registered) & exec /etc/temporal/entrypoint.sh autosetup\"",
        "healthcheckPath": "/api/v1/system-info",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "temporalio/auto-setup:1.29.7"
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {},
      "variables": {
        "PORT": {
          "defaultValue": "7243",
          "description": "Temporal frontend HTTP API port, used by Railway's health check - leave as is",
          "isOptional": false
        },
        "DB": {
          "defaultValue": "postgres12",
          "description": "Temporal persistence driver for Postgres",
          "isOptional": false
        },
        "DB_PORT": {
          "defaultValue": "5432",
          "description": "Postgres port",
          "isOptional": false
        },
        "POSTGRES_SEEDS": {
          "defaultValue": "${{Postgres.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Postgres host (Temporal creates its own temporal and temporal_visibility databases)",
          "isOptional": false
        },
        "POSTGRES_USER": {
          "defaultValue": "${{Postgres.POSTGRES_USER}}",
          "description": "Postgres user",
          "isOptional": false
        },
        "POSTGRES_PWD": {
          "defaultValue": "${{Postgres.POSTGRES_PASSWORD}}",
          "description": "Postgres password",
          "isOptional": false
        },
        "BIND_ON_IP": {
          "defaultValue": "::",
          "description": "Listen on IPv6 and IPv4 for Railway's private network",
          "isOptional": false
        },
        "TEMPORAL_BROADCAST_ADDRESS": {
          "defaultValue": "127.0.0.1",
          "description": "Single node: cluster members find each other on loopback",
          "isOptional": false
        },
        "TEMPORAL_ADDRESS": {
          "defaultValue": "127.0.0.1:7233",
          "description": "Address the setup CLI uses inside the container",
          "isOptional": false
        },
        "SKIP_ADD_CUSTOM_SEARCH_ATTRIBUTES": {
          "defaultValue": "true",
          "description": "Skip Temporal's sample search attributes; Airweave's SyncId is registered by the start command",
          "isOptional": false
        }
      }
    },
    "65068edc-e562-40c8-8740-f934a6658445": {
      "icon": "https://raw.githubusercontent.com/nomideusz/airweave-railway/main/icons/vespa.svg",
      "name": "Vespa",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/state/v1/health",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/nomideusz/airweave-railway",
        "rootDirectory": "/vespa"
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "a53d9f18-482c-484b-9907-406ecc4ec7d5": {
          "mountPath": "/opt/vespa/var"
        }
      },
      "variables": {
        "PORT": {
          "defaultValue": "8081",
          "description": "Vespa query and document API port, used by Railway's health check - leave as is",
          "isOptional": false
        },
        "EMBEDDING_DIMENSIONS": {
          "defaultValue": "1024",
          "description": "Vector size of the search schema: 1024 for mistral_embed, 1536 for openai_text_embedding_3_small, 3072 for _large. Set before the first deploy; fixed afterwards",
          "isOptional": false
        },
        "RAILWAY_HEALTHCHECK_TIMEOUT_SEC": {
